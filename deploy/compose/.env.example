# Leave empty for dev/test. MUST be a strong unique value for any non-dev ENGRAM_ENVIRONMENT;
# an empty or known-placeholder value is rejected outside dev/test.
ENGRAM_SECRET_KEY=
# dev|development|local|test are non-production. Any other value (e.g. production, staging)
# enforces ENGRAM_SECRET_KEY and ENGRAM_ALLOWED_HOSTS.
ENGRAM_ENVIRONMENT=dev
ENGRAM_DEBUG=false
ENGRAM_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
ENGRAM_LOG_LEVEL=INFO
# --- Sentry (optional; all empty => Sentry is never initialised anywhere) ---
# NOTE: the NEXT_PUBLIC_* frontend values below are consumed by compose variable
# interpolation (the ${VAR} refs in docker-compose.yml) read from the project-directory .env
# — NOT via ENGRAM_ENV_FILE/env_file. They must live in the compose project .env to reach
# the frontend build/entrypoint; putting them only in an ENGRAM_ENV_FILE will not work.
# Backend DSN (self-hosted Sentry, backend project). Empty/unset => sentry_sdk.init is not
# called at all. Reaches every backend process via env_file.
SENTRY_DSN=
# Browser + frontend-server DSN (frontend project — a DIFFERENT DSN from the backend one).
NEXT_PUBLIC_SENTRY_DSN=
# Ingest ORIGIN only, no key or path, e.g. https://sentry.internal.example. MUST be set
# whenever NEXT_PUBLIC_SENTRY_DSN is, or the frontend CSP blocks every browser event.
NEXT_PUBLIC_SENTRY_CSP_ORIGIN=
# Sentry `environment` for backend + frontend. Backend falls back to ENGRAM_ENVIRONMENT.
SENTRY_ENVIRONMENT=
# Optional release identifier tagged on backend and frontend events (e.g. the image tag).
ENGRAM_RELEASE=
# Backend tracing: the head sampler traces everything and before_send_transaction keeps
# this fraction. 0 => no transactions sent. Error reporting is unaffected.
SENTRY_TRACES_SAMPLE_RATE=0.1
# Backend profiling fraction (0 disables).
SENTRY_PROFILES_SAMPLE_RATE=0.05
# Browser tracing fraction; empty or 0 => errors only.
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=
ENGRAM_CELERY_BROKER_URL=amqp://engram:engram@rabbitmq:5672/engram
# Optional RabbitMQ node identity; these examples are the Compose defaults.
# ENGRAM_RABBITMQ_HOSTNAME=rabbitmq
# ENGRAM_RABBITMQ_NODENAME=rabbit@rabbitmq
# D2 must set both values to the exact recorded identity. The nodename suffix and
# hostname must agree; never guess either value independently.
ENGRAM_CELERY_RESULT_BACKEND=redis://redis:6379/1
ENGRAM_BOOTSTRAP_ADMIN_USERNAME=admin
ENGRAM_BOOTSTRAP_ADMIN_PASSWORD=
ENGRAM_BOOTSTRAP_ORG_SLUG=default
ENGRAM_BOOTSTRAP_PROJECT_SLUG=default
ENGRAM_BOOTSTRAP_TEAM_SLUG=default
# Minutes of inactivity before an ACTIVE agent session is force-ended and distilled
ENGRAM_SESSION_IDLE_TIMEOUT_MINUTES=30
# --- Provider sockets and the celery timeout ladder ---
# Operational envelope (engram/core/provider_timeouts.py owns it, and
# engram/core/deployment_contract_tests.py re-checks THIS file against it):
# every celery limit and work lease starts from a fixed per-work-type baseline and is then
# stretched by however much longer the sockets it chains can block:
#   soft += chained chat calls x (chat socket - 60) + chained embeddings x (embedding socket - 30)
#   hard  = soft + the baseline's own hard-minus-soft gap;  lease = hard + its lease gap
# Leave the sockets at their defaults and every limit stays exactly where it was.
# Pinning ENGRAM_*_SOFT_TIME_LIMIT / ENGRAM_*_TIME_LIMIT / ENGRAM_*_LEASE_SECONDS is
# supported: the pin replaces that step and the steps above it are derived from the pin.
# Socket for a chat completion sent WITHOUT a service tier.
ENGRAM_PROVIDER_HTTP_TIMEOUT=60
# Flex-tier chat completions queue on the provider side and block far longer, so a deployment
# that uses flex must say so HERE. Until it does, the flex socket collapses to
# ENGRAM_PROVIDER_HTTP_TIMEOUT and no celery limit or lease moves: on a stand that never sends
# a service tier (DeepSeek/Anthropic-only), flex-sized leases would only delay reclaiming work
# stranded by a dead worker. Turning it on raises the flex socket to 600s (the client timeout
# OpenAI recommends for flex) and grows every work type that chains chat calls by 540s per call
# -- session distillation goes 600/660/720 -> 1680/1740/1800, so re-check the worker
# stop_grace_period in docker-compose.yml if you also shorten it.
# ENGRAM_FLEX_TIMEOUT_SIZING=1
# Override the flex socket itself. Either of these moves the ladder on its own, with or
# without the switch above, because the ladder always tracks the socket the gateway will use.
# ENGRAM_FLEX_PROCESSING_CEILING=600
# ENGRAM_FLEX_HTTP_TIMEOUT=600
# Embeddings are never flex-eligible and answer fast, so they keep a short socket of
# their own; embedding work is sized from this value, not from the chat sockets.
ENGRAM_EMBEDDING_HTTP_TIMEOUT=30
ENGRAM_DISTILL_CHUNK_CHAR_BUDGET=40000
ENGRAM_DISTILL_REDUCE_TARGET=12
# Upper bound on provider calls one distillation attempt may start before it yields and
# re-queues the remaining chunks. It is only a cap: the attempt also refuses to start a call
# that cannot finish before its own soft time limit, so the ladder above is what actually
# keeps a call from being killed mid-flight.
# ENGRAM_DISTILL_MAX_PROVIDER_CALLS_PER_ATTEMPT=8
# Emit ops counter gauges as global aggregates without per-tenant labels.
ENGRAM_OPS_GLOBAL_COUNTERS=true
# Minimum observation content length (chars) before a realtime candidate is generated.
ENGRAM_REALTIME_MIN_CONTENT_CHARS=80
